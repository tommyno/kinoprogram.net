---
// "+ N tider til" under a list of times collapsed to the first few. The Program script opens it and keeps the count right
import { moreLabel } from '@lib/display.ts';
import styles from './MoreButton.module.css';

type Props = {
  /** The times not shown. */
  count: number;
  class?: string;
};

const { count, class: className } = Astro.props;
---

<button type="button" class:list={[styles.more, className]} aria-expanded="false" hidden={count <= 0} data-more>
  {moreLabel(count)}
</button>
