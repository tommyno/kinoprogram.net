---
import BackLink from '@components/BackLink/BackLink.astro';
import DayLabel from '@components/DayLabel/DayLabel.astro';
import ExternalLink from '@components/ExternalLink/ExternalLink.astro';
import Footer from '@components/Footer/Footer.astro';
import PosterSwitch from '@components/PosterSwitch/PosterSwitch.astro';
import ShowingColumn from '@components/ShowingColumn/ShowingColumn.astro';
import ShowingColumns from '@components/ShowingColumns/ShowingColumns.astro';
import Base from '@layouts/Base.astro';
import { CINEMAS } from '@lib/cinemas.ts';
import { showingDays } from '@lib/program.ts';
import { getProgram } from '@lib/source.ts';
import { programNow } from '@lib/time.ts';
import styles from './CinemaPage.module.css';

type Props = {
  name: string;
};

const { name } = Astro.props;
const program = await getProgram();
const today = programNow().day;
const cinema = CINEMAS.find((c) => c.name === name);
const days = showingDays(program, today, (s) => s.cinema === name);
// "deichman.no", as the button names the cinema's site
const host = cinema && new URL(cinema.url).hostname.replace(/^www\./, '');
// With the name, so Google Maps finds the cinema itself rather than just the street address
const mapUrl =
  cinema && `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${name}, ${cinema.address}`)}`;
---

<Base title={`${name} – Kinoprogram for Oslo`} description={`Alle visningene på ${name}, dag for dag.`}>
  <BackLink />

  <header class={styles.header}>
    <div class={styles.titleBlock}>
      <h1 class={styles.title}>{name}</h1>
      {cinema && (
        <p class={styles.address}>
          <a href={mapUrl} target="_blank" rel="noreferrer">
            {cinema.address}
          </a>
        </p>
      )}
    </div>
    {cinema?.about && <p class={styles.about}>{cinema.about}</p>}
    {cinema && <ExternalLink href={cinema.url}>{host}</ExternalLink>}
  </header>

  {days.length === 0 ? (
    <p class={styles.empty}>Ingen visninger nå.</p>
  ) : (
    <>
      <PosterSwitch />
      <ShowingColumns>
        {days.map(([day, list], index) => (
          <ShowingColumn films={program.films} showings={list} index={index} day={day}>
            <DayLabel slot="heading" day={day} today={today} />
          </ShowingColumn>
        ))}
      </ShowingColumns>
    </>
  )}

  <Footer />
</Base>

<script>
  import { keepDaysCurrent } from '@lib/browser.ts';

  keepDaysCurrent();
</script>
