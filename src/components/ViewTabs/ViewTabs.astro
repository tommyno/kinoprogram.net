---
import styles from './ViewTabs.module.css';

const VIEWS = [
  { key: 'film', label: 'Film', href: '/' },
  { key: 'tid', label: 'Tidspunkt', href: '/?sorter=tid' },
  { key: 'kino', label: 'Kino', href: '/?sorter=kino' },
];

type Props = {
  /** On the search page the views link back to today's program; otherwise they are tabs the Program script switches. */
  onSearch?: boolean;
};

const { onSearch = false } = Astro.props;
---

{onSearch ? (
  <nav aria-label="Visning" class={styles.tabs}>
    {VIEWS.map((view) => (
      <a href={view.href} class={styles.tab}>
        {view.label}
      </a>
    ))}
    <a href="/sok" class={styles.tab} aria-current="page">
      Søk
    </a>
  </nav>
) : (
  <div class={styles.tabs}>
    <div role="tablist" aria-label="Visning" class={styles.tablist}>
      {VIEWS.map((view) => (
        <button
          type="button"
          role="tab"
          id={`tab-${view.key}`}
          class={styles.tab}
          aria-selected={view.key === 'film' ? 'true' : 'false'}
          aria-controls={`view-${view.key}`}
          tabindex={view.key === 'film' ? 0 : -1}
          data-sort={view.key}
        >
          {view.label}
        </button>
      ))}
    </div>
    <a href="/sok" class={styles.tab}>
      Søk
    </a>
    <span class={styles.indicator} aria-hidden="true" data-indicator />
  </div>
)}

<script>
  // Program's tabs: each shows the view it controls, keeps the choice in ?sorter= so a link opens the same view, and
  // slides the bar under itself. Arrow keys move between them, as in any tablist
  const tabs = [...document.querySelectorAll<HTMLElement>('[role="tab"]')];
  const indicator = document.querySelector<HTMLElement>('[data-indicator]');

  function placeIndicator() {
    const tab = tabs.find((tab) => tab.getAttribute('aria-selected') === 'true')!;
    indicator!.style.width = `${tab.offsetWidth}px`;
    indicator!.style.transform = `translateX(${tab.offsetLeft}px)`;
  }

  function showSort(sort: string) {
    for (const tab of tabs) {
      const selected = tab.dataset.sort === sort;
      tab.setAttribute('aria-selected', String(selected));
      tab.tabIndex = selected ? 0 : -1;
      // None on a day without showings
      const view = document.getElementById(tab.getAttribute('aria-controls')!);
      if (view) view.hidden = !selected;
    }
    placeIndicator();
  }

  function selectSort(sort: string) {
    // Only slide when the visitor switches, not when the bar is first placed
    indicator!.toggleAttribute('data-slide', true);
    // Switching views fades the items in again, also on a page the visitor came back to
    document.documentElement.removeAttribute('data-returned');
    showSort(sort);
    const url = new URL(location.href);
    if (sort === 'film') url.searchParams.delete('sorter');
    else url.searchParams.set('sorter', sort);
    history.replaceState(null, '', url);
  }

  for (const [index, tab] of tabs.entries()) {
    tab.addEventListener('click', () => selectSort(tab.dataset.sort!));
    tab.addEventListener('keydown', (event) => {
      const step = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
      if (!step) return;
      const next = tabs[(index + step + tabs.length) % tabs.length];
      next.focus();
      selectSort(next.dataset.sort!);
    });
  }

  if (tabs.length > 0) {
    const fromUrl = new URLSearchParams(location.search).get('sorter');
    if (tabs.some((tab) => tab.dataset.sort === fromUrl)) showSort(fromUrl!);

    // Tab widths change with the viewport and once the font loads
    const resizeObserver = new ResizeObserver(placeIndicator);
    tabs.forEach((tab) => resizeObserver.observe(tab));
  }
</script>
