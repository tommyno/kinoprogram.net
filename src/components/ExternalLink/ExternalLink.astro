---
// A button-styled link to another site, such as a film's source or a cinema's own site, opening in a new tab
import styles from './ExternalLink.module.css';

type Props = {
  href: string;
};

const { href } = Astro.props;
---

{/* biome-ignore lint/a11y/useAnchorContent: the text comes in the slot */}
<a {href} class={styles.link} target="_blank" rel="noreferrer">
  <slot />
  <svg
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"></path>
  </svg>
</a>
