---
import { cinemaPath } from '@lib/cinemas.ts';
import { collator, type Film, type Showing } from '@lib/program.ts';
import { formatShortDay } from '@lib/time.ts';
import ShowingColumn from '@components/ShowingColumn/ShowingColumn.astro';
import ShowingColumns from '@components/ShowingColumns/ShowingColumns.astro';
import styles from './CinemaColumns.module.css';

type Props = {
  films: Record<string, Film>;
  showings: Showing[];
  /** The cinemas with nothing on this day and their next day with showings, so the ones that rarely show films are not lost. */
  later: { cinema: string; day: string }[];
};

const { films, showings, later } = Astro.props;
const cinemas = [...Map.groupBy(showings, (s) => s.cinema)].sort(([a], [b]) => collator.compare(a, b));
---

<ShowingColumns>
  {cinemas.map(([cinema, list], index) => (
    <ShowingColumn films={films} showings={list} index={index} collapsed>
      <a slot="heading" href={cinemaPath(cinema)} class={styles.nameLink}>
        {cinema}
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>
    </ShowingColumn>
  ))}
  {/* Below the cinemas showing films, as a quieter list of those that aren't */}
  {later.length > 0 && (
    <section class={styles.later} data-stagger style={`--i: ${cinemas.length}`}>
      <h2 class={styles.laterHeading}>Ingen visninger denne dagen</h2>
      {later.map(({ cinema, day }) => (
        <a href={cinemaPath(cinema)} class={styles.laterRow}>
          <span class={styles.laterName}>{cinema}</span>
          <span class={styles.laterDay}>{formatShortDay(day)}</span>
        </a>
      ))}
    </section>
  )}
</ShowingColumns>
