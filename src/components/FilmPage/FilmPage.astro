---
import BackLink from '@components/BackLink/BackLink.astro';
import DayLabel from '@components/DayLabel/DayLabel.astro';
import ExternalLink from '@components/ExternalLink/ExternalLink.astro';
import Footer from '@components/Footer/Footer.astro';
import PosterZoom from '@components/PosterZoom/PosterZoom.astro';
import ShowingLink from '@components/ShowingLink/ShowingLink.astro';
import Synopsis from '@components/Synopsis/Synopsis.astro';
import TrailerButton from '@components/TrailerButton/TrailerButton.astro';
import Base from '@layouts/Base.astro';
import { filmMeta, listParts } from '@lib/display.ts';
import { type Person, showingAnchor, showingDays } from '@lib/program.ts';
import { getProgram } from '@lib/source.ts';
import { programNow } from '@lib/time.ts';
import styles from './FilmPage.module.css';

type Props = {
  filmId: string;
};

const { filmId } = Astro.props;
const program = await getProgram();
const today = programNow().day;
const film = program.films[filmId];
const days = showingDays(program, today, (s) => s.filmId === filmId);
const meta = filmMeta(film);
const credits: [string, Person[]][] = [];
if (film.directors?.length) credits.push(['Regi', film.directors]);
if (film.cast?.length) credits.push(['Med', film.cast]);
---

<Base
  title={`${film.title} – Kinoprogram for Oslo`}
  description={`Alle visningene av ${film.title} på kino i Oslo, dag for dag.`}
>
  <div class={styles.top}>
    <div class={styles.backdrop} aria-hidden="true">
      {film.posterUrl && <img src={film.posterUrl} alt="" />}
    </div>

    <BackLink />

    <header class={styles.header}>
      <PosterZoom film={film} class={styles.poster} />
      <div class={styles.heading} data-heading>
        <div class={styles.titleBlock}>
          <h1 class={styles.title}>{film.title}</h1>
          {meta && <p class={styles.meta}>{meta}</p>}
        </div>
        <div class={styles.body}>
          {film.synopsis && <Synopsis text={film.synopsis} />}
          {credits.length > 0 && (
            <p class={styles.credits}>
              {credits.map(([label, people]) => (
                <span>
                  {label}:{' '}
                  {listParts(people).map((p) =>
                    typeof p === 'string' ? (
                      p
                    ) : (
                      <a href={p.url} target="_blank" rel="noreferrer">
                        {p.name}
                      </a>
                    ),
                  )}
                </span>
              ))}
            </p>
          )}
          <div class={styles.actions}>
            {film.trailer && <TrailerButton youtubeId={film.trailer} controls="trailer" />}
            <ExternalLink href={film.pageUrl}>{film.source}</ExternalLink>
          </div>
        </div>
      </div>
    </header>
  </div>

  {film.trailer && (
    <div id="trailer" class={styles.trailer} hidden>
      <div class={styles.player} data-player></div>
    </div>
  )}

  <div>
    {days.map(([day, list], index) => (
      <section class={styles.day} data-stagger style={`--i: ${index}`} data-day-section={day}>
        <h2 class={styles.dayHeading}>
          <DayLabel day={day} today={today} />
        </h2>
        <div class={styles.times}>
          {list.map((s) => (
            <ShowingLink
              showing={s}
              text={[s.time, s.cinema, s.screen]}
              context={film.title}
              anchor={showingAnchor(s)}
              class={styles.row}
            >
              <span class={styles.time}>{s.time}</span> <span class={styles.where}>{s.cinema}</span>{' '}
              <span class={styles.screen}>{s.screen}</span>
            </ShowingLink>
          ))}
        </div>
      </section>
    ))}
  </div>

  <Footer />
</Base>

<script>
  import { keepDaysCurrent } from '@lib/browser.ts';

  const links = keepDaysCurrent();

  // Coming from a time in the program (see showingPath), mark that showing
  links.find((link) => link.dataset.showing === location.hash.slice(1))?.toggleAttribute('data-chosen', true);
</script>
